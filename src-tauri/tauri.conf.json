{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacTheme",
  "version": "0.1.0",
  "identifier": "me.sumitsharma.mactheme",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "windows": {
      "nsis": { "displayLanguageSelector": false, "installMode": "currentUser" }
    }
  }
}
