{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Only local shell windows; native operations are validated Rust commands.",
  "windows": [
    "bar-*",
    "dock-*",
    "panel",
    "spotlight",
    "settings",
    "notch-*"
  ],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
